# ─── apps/web ─────────────────────────────────────────────────────────────────
# Copy to apps/web/.env.local and fill in values from your Supabase project.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Sentry — create a project at sentry.io and paste the DSN here.
# NEXT_PUBLIC prefix makes it available in the browser bundle (client errors).
NEXT_PUBLIC_SENTRY_DSN=https://your-key@oXXXXXX.ingest.sentry.io/XXXXXXX
SENTRY_AUTH_TOKEN=your-sentry-auth-token-here   # for source map uploads at build time

# Paystack — get keys from dashboard.paystack.com → Settings → API Keys
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_live_xxxxxxxxxxxxx
PAYSTACK_SECRET_KEY=sk_live_xxxxxxxxxxxxx

# ─── supabase/functions ────────────────────────────────────────────────────────
# Copy to supabase/functions/.env — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
RESEND_API_KEY=your-resend-api-key-here          # resend.com — transactional email
ARKESEL_API_KEY=your-arkesel-api-key-here        # arkesel.com — SMS alerts (Ghana)
